#5.replace last value of tuples in a list to 100
n=[(10,20,30),(40,50,60),(70,80,90)]
nl=[]
for i in n:
    nt=i[:-1]+(100,)
    nl.append(nt)
print('Original list:',n)
print("Updated list:",nl)

#output
Original list: [(10, 20, 30), (40, 50, 60), (70, 80, 90)]
Updated list: [(10, 20, 100), (40, 50, 100), (70, 80, 100)]



