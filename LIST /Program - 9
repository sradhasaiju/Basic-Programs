'''
to accept 20 numbers and save it in a list and perform the following operation:
a.count similar elements of list and print their index value   
b.count even and odd values of list 
c.count positive and negative values of list.
'''

n=[]
c=0
for i in range(20):
    o=int(input('Enter value:'))
    n.append(o)
print('\nLIST:',n)

#a. count similar elements and print their index values
k=[]
for j in range(20):
    if n[j] not in k and n.count(n[j])>1:
        print('Number',n[j],'repeats at indexes ->',end=' ')
        for l in range(20):
            if n[l]==n[j]:
                print(l,end=',')
        print()
    k.append(n[j])
    
#b.count even and odd values of list 
e=0
o=0
for i in n:
    if i%2==0:
        e+=1
    else:
        o+=1
print('Even no:',e)
print('Odd no:',o)

#c.count positive and negative values of list.
p=0
l=0
for j in n:
    if j>0:
        p+=1
    elif j<0:
        l+=1
print('Positive no:',p)
print('Negative no:',l)

